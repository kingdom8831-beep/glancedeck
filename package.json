{
  "name": "floatdeck",
  "version": "0.1.1",
  "private": true,
  "description": "瞬览：Codex 用量、A 股行情与天气桌面悬浮窗",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build:native": "swiftc -O -framework AppKit native/GlanceDeckMenuBar.swift -o build/GlanceDeckMenuBar",
    "dev": "npm run build:native && node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build:native && npm run build && electron .",
    "package:mac": "npm run build:native && npm run build && electron-builder --mac dir",
    "screenshots:readme": "npm run build && node scripts/capture-readme.mjs"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "build": {
    "appId": "com.glancedeck.desktop",
    "productName": "瞬览 GlanceDeck",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/trayStatus.png",
      "build/trayStatus@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "build/trayStatus.png",
        "to": "trayStatus.png"
      },
      {
        "from": "build/trayStatus@2x.png",
        "to": "trayStatus@2x.png"
      },
      {
        "from": "build/GlanceDeckMenuBar",
        "to": "GlanceDeckMenuBar"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSLocationUsageDescription": "瞬览使用当前位置提供本地天气与未来七日预报。",
        "NSLocationWhenInUseUsageDescription": "瞬览使用当前位置提供本地天气与未来七日预报。"
      },
      "target": [
        "dir"
      ]
    }
  }
}
